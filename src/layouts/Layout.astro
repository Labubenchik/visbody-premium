---
import "../styles/global.css";
import { Font } from "astro:assets";
import Navbar from "@modules/navbar/Navbar.astro";
import Footer from "@modules/footer/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable="--font-google-sans" preload />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<div
			class="bg-transparent min-h-screen text-white font-sans antialiased overflow-x-hidden selection:bg-brand-accent/30">
			<!-- <CustomCursor /> -->
			<div class="noise-overlay"></div>
			<Navbar />
			<slot />
			<Footer />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
