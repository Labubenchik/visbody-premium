---
import { Mail, MapPin, Phone } from "@lucide/astro";
import { CONTACT_DATA, ROUTES } from "@/static-data";

const FOOTER_NAV_LINKS = [
	ROUTES.technology,
	ROUTES.cases,
	ROUTES.blog,
	ROUTES.contact,
	ROUTES.solutions.children.fitness,
	ROUTES.solutions.children.medical,
] as const;

const PRODUCT_LINKS = [
	ROUTES.catalog.сhildren.m60,
	ROUTES.catalog.сhildren.m30,
	ROUTES.catalog.сhildren.s30,
	ROUTES.catalog.сhildren.a600,
] as const;

const currentYear = new Date().getFullYear() || 2026;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => {
	const normalizedHref = href.replace(/\/$/, "") || "/";

	return currentPath === normalizedHref || (normalizedHref !== "/" && currentPath.startsWith(`${normalizedHref}/`));
};
---

<footer class="footer">
	<div class="footer__glow" aria-hidden="true"></div>

	<div class="footer__inner">
		<div class="footer__top">
			<nav class="footer__section" aria-labelledby="footer-navigation-title">
				<h2 class="footer__title" id="footer-navigation-title">Навигация</h2>
				<ul class="footer__links">
					{
						FOOTER_NAV_LINKS.map((link) => (
							<li>
								<a
									class="footer__link"
									href={link.href}
									aria-current={isCurrent(link.href) ? "page" : undefined}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer__section" aria-labelledby="footer-products-title">
				<h2 class="footer__title" id="footer-products-title">Каталог</h2>
				<ul class="footer__links">
					{
						PRODUCT_LINKS.map((link) => (
							<li>
								<a
									class="footer__link"
									href={link.href}
									aria-current={isCurrent(link.href) ? "page" : undefined}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<section class="footer__section" aria-labelledby="footer-contacts-title">
				<h2 class="footer__title" id="footer-contacts-title">Контакты</h2>
				<address class="footer__contacts">
					<a class="footer__contact-link" href={CONTACT_DATA.phone.link}>
						<Phone class="footer__icon" size={16} aria-hidden="true" />
						<span>{CONTACT_DATA.phone.label}</span>
					</a>
					<a class="footer__contact-link" href={CONTACT_DATA.email.link}>
						<Mail class="footer__icon" size={16} aria-hidden="true" />
						<span>{CONTACT_DATA.email.label}</span>
					</a>
					<a class="footer__contact-link" href={CONTACT_DATA.address.link}>
						<MapPin class="footer__icon" size={16} aria-hidden="true" />
						<span>{CONTACT_DATA.address.label}</span>
					</a>
				</address>
			</section>
		</div>

		<div class="footer__bottom">
			<p class="footer__copyright">© {currentYear} Visbody Russia</p>
			<nav class="footer__legal" aria-label="Юридическая информация">
				<a class="footer__legal-link" href="#">Политика конфиденциальности</a>
				<a class="footer__legal-link" href="#">Публичная оферта</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		overflow: hidden;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		background:
			linear-gradient(180deg, rgba(10, 25, 48, 0.32) 0%, rgba(2, 6, 23, 0.94) 42%), var(--color-brand-dark);
	}

	.footer__glow {
		position: absolute;
		right: max(-180px, -10vw);
		bottom: -220px;
		width: min(720px, 82vw);
		aspect-ratio: 1.6;
		border-radius: 999px;
		background: rgba(14, 165, 233, 0.1);
		filter: blur(110px);
		pointer-events: none;
	}

	.footer__inner {
		position: relative;
		z-index: 1;
		width: min(100% - 32px, 1280px);
		margin: 0 auto;
		padding: clamp(64px, 8vw, 96px) 0 40px;
	}

	.footer__top {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(32px, 4vw, 56px);
	}

	.footer__section {
		min-width: 0;
	}

	.footer__title {
		margin: 0 0 22px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.2em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.footer__links,
	.footer__contacts {
		display: grid;
		gap: 14px;
		margin: 0;
		padding: 0;
	}

	.footer__links {
		list-style: none;
	}

	.footer__contacts {
		font-style: normal;
	}

	.footer__link,
	.footer__contact-link,
	.footer__legal-link {
		color: #94a3b8;
		font-family: var(--font-sans);
		text-decoration: none;
		transition:
			color 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.footer__link,
	.footer__legal-link {
		display: inline-flex;
		width: fit-content;
		border-radius: 8px;
	}

	.footer__link {
		font-size: 14px;
		line-height: 1.4;
	}

	.footer__contact-link {
		display: grid;
		grid-template-columns: 34px minmax(0, 1fr);
		align-items: center;
		gap: 10px;
		border-radius: 12px;
		font-size: 14px;
		line-height: 1.45;
	}

	.footer__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 8px;
		border: 1px solid rgba(14, 165, 233, 0.2);
		border-radius: 10px;
		background: rgba(14, 165, 233, 0.08);
		color: var(--color-brand-accent);
	}

	.footer__link:hover,
	.footer__link:focus-visible,
	.footer__link[aria-current="page"],
	.footer__contact-link:hover,
	.footer__contact-link:focus-visible,
	.footer__legal-link:hover,
	.footer__legal-link:focus-visible {
		color: #7dd3fc;
	}

	.footer__contact-link:hover .footer__icon,
	.footer__contact-link:focus-visible .footer__icon {
		border-color: rgba(14, 165, 233, 0.46);
		background: rgba(14, 165, 233, 0.14);
	}

	.footer__link:focus-visible,
	.footer__contact-link:focus-visible,
	.footer__legal-link:focus-visible {
		outline: 2px solid rgba(14, 165, 233, 0.72);
		outline-offset: 3px;
	}

	.footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: clamp(48px, 6vw, 72px);
		padding-top: 28px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.footer__copyright {
		margin: 0;
		color: #64748b;
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 16px 28px;
	}

	.footer__legal-link {
		color: #64748b;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}
	@media (max-width: 980px) {
		.footer__top {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.footer__inner {
			width: min(100% - 24px, 1280px);
			padding-top: 56px;
		}

		.footer__top {
			grid-template-columns: 1fr;
			gap: 34px;
		}

		.footer__title {
			margin-bottom: 16px;
		}

		.footer__links {
			gap: 10px;
		}

		.footer__link {
			display: flex;
			width: 100%;
			padding: 10px 0;
		}

		.footer__contact-link {
			grid-template-columns: 32px minmax(0, 1fr);
			gap: 9px;
		}

		.footer__icon {
			width: 32px;
			height: 32px;
			padding: 7px;
		}

		.footer__bottom {
			align-items: flex-start;
			flex-direction: column;
			margin-top: 44px;
		}

		.footer__legal {
			justify-content: flex-start;
			gap: 12px 22px;
		}
	}
</style>
