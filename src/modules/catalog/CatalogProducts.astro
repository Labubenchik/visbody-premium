---
import { ArrowRight } from "@lucide/astro";
import { ROUTES } from "@/static-data";

import a600Image from "@modules/home/hero-section/assets/creator-A600.webp";
import m30Image from "@modules/home/hero-section/assets/m-30.webp";
import m60Image from "@modules/home/hero-section/assets/m-60.webp";
import s30Image from "@modules/home/hero-section/assets/s-30.webp";

const products = [
	{
		...ROUTES.catalog.сhildren.m60,
		image: m60Image.src,
		kicker: "Флагманский 3D-сканер",
		description:
			"Интеллектуальный анализ состава тела, 3D-моделирование и экспертная аналитика для премиум-клубов.",
	},
	{
		...ROUTES.catalog.сhildren.m30,
		image: m30Image.src,
		kicker: "3D-анализатор осанки",
		description: "Оценка осанки, 14 автоматических измерений и визуализация прогресса для фитнеса и реабилитации.",
	},
	{
		...ROUTES.catalog.сhildren.s30,
		image: s30Image.src,
		kicker: "Гибридный BIA + рост",
		description: "3D-анализатор тела с лазерным измерением роста и точной диагностикой для фитнес-клубов.",
	},
	{
		...ROUTES.catalog.сhildren.a600,
		image: a600Image.src,
		kicker: "AI-анализ техники бега",
		description: "Беговая дорожка с 3D-анализом биомеханики в реальном времени для спорта и реабилитации.",
	},
];
---

<section class="products-section" aria-label="Каталог оборудования">
	<div class="container">
		<div class="products-grid">
			{
				products.map(({ label, href, image, kicker, description }) => (
					<a class="product-card" href={href} aria-label={`Открыть страницу ${label}`}>
						<div class="media">
							<img src={image} alt={label} loading="lazy" decoding="async" />
						</div>
						<div class="content">
							<div class="meta">{kicker}</div>
							<h2>{label}</h2>
							<p>{description}</p>
							<span class="link">
								Подробнее <ArrowRight size={18} stroke-width={2} />
							</span>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.products-section {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 44px 24px 112px;
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.product-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(180px, 0.82fr) minmax(0, 1fr);
		min-height: 320px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 32px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.66), rgba(15, 23, 42, 0.4)),
			radial-gradient(circle at 18% 0%, rgba(14, 165, 233, 0.12), transparent 54%);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		color: inherit;
		text-decoration: none;
		backdrop-filter: blur(24px);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease,
			transform 0.3s ease;

		&:hover {
			transform: translateY(-4px);
			border-color: rgba(14, 165, 233, 0.32);
			box-shadow: 0 30px 90px rgba(0, 0, 0, 0.3);

			& img {
				transform: scale(1.05);
			}

			& .link svg {
				transform: translateX(4px);
			}
		}
	}

	.media {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		padding: 28px 8px 28px 24px;
		background: radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.18), transparent 58%);

		& img {
			display: block;
			width: min(100%, 260px);
			height: 100%;
			max-height: 260px;
			object-fit: contain;
			filter: drop-shadow(0 22px 42px rgba(14, 165, 233, 0.16));
			transition: transform 0.3s ease;
		}
	}

	.content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
		padding: 32px 32px 32px 18px;
	}

	.meta,
	.link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.meta {
		color: rgba(125, 211, 252, 0.92);
	}

	h2 {
		margin: 22px 0 14px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(28px, 3vw, 38px);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.045em;
	}

	p {
		margin: 0;
		color: rgba(203, 213, 225, 0.78);
		font-family: var(--font-sans);
		font-size: 15px;
		line-height: 1.62;
		letter-spacing: -0.01em;
	}

	.link {
		margin-top: auto;
		padding-top: 24px;
		color: #ffffff;

		& svg {
			transition: transform 0.3s ease;
		}
	}

	@media (max-width: 1040px) {
		.products-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 680px) {
		.products-section {
			padding: 0 16px 88px;
		}

		.product-card {
			grid-template-columns: 1fr;
			min-height: auto;
			border-radius: 26px;
		}

		.media {
			padding: 28px 24px 0;

			& img {
				max-height: 220px;
			}
		}

		.content {
			padding: 26px 24px 30px;
		}
	}
</style>
