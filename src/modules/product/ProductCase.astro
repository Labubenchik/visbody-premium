---
type Props = {
	stats?: {
		value: string;
		label: string;
	}[];
};

const { stats = [{ value: "+498%", label: "ROI за 12 месяцев" }] } = Astro.props as Props;
---

<section class="case-section">
	<div class="container">
		<div class="case-container">
			<h2 class="section-title">
				<slot name="title" />
			</h2>
			<div class="stats-row">
				{
					stats.map(({ value, label }) => (
						<div class="stat-item">
							<h3>{value}</h3>
							<p>{label}</p>
						</div>
					))
				}
			</div>
			<p class="case-note"><slot name="description" /></p>
		</div>
	</div>
</section>

<style>
	.case-section {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 96px 24px 112px;
		background:
			linear-gradient(135deg, rgba(2, 6, 23, 0.1) 0%, rgba(10, 25, 47, 0.28) 100%),
			radial-gradient(circle at 50% 18%, rgba(14, 165, 233, 0.13), transparent 36%);
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.case-container {
		max-width: 960px;
		margin: 0 auto;
		text-align: center;
	}

	.section-title {
		max-width: 860px;
		margin: 0 auto 42px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(38px, 5vw, 52px);
		font-weight: 800;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-align: center;
		text-transform: uppercase;

		& > :global(.title-accent) {
			letter-spacing: -0.025em;
		}
	}

	.stats-row {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		margin: 0 auto 34px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 32px;
		background: rgba(255, 255, 255, 0.07);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);

		&::before {
			position: absolute;
			top: 0;
			left: 50%;
			width: 100%;
			height: 3px;
			border-radius: 999px;
			background: linear-gradient(90deg, transparent, var(--color-brand-accent), transparent);
			content: "";
			transform: translateX(-50%);
		}
	}

	.stat-item {
		position: relative;
		display: flex;
		min-height: 230px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 42px 34px;
		background: rgba(15, 23, 42, 0.54);
	}

	.stat-item {
		& h3 {
			margin: 0 0 14px;
			background: linear-gradient(135deg, var(--color-brand-accent), #60a5fa);
			background-clip: text;
			-webkit-background-clip: text;
			color: transparent;
			font-family: var(--font-sans);
			font-size: clamp(58px, 8vw, 92px);
			font-weight: 800;
			line-height: 0.95;
			letter-spacing: -0.04em;
		}

		& p {
			max-width: 310px;
			margin: 0;
			color: #cbd5e1;
			font-family: var(--font-sans);
			font-size: 17px;
			font-weight: 700;
			line-height: 1.45;
			letter-spacing: -0.015em;
			opacity: 0.86;
		}
	}

	.case-note {
		max-width: 720px;
		margin: 0 auto;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 18px;
		line-height: 1.7;
		letter-spacing: -0.015em;
		opacity: 0.82;
	}

	@media (max-width: 992px) {
		.case-section {
			padding: 76px 20px 92px;
		}
	}

	@media (max-width: 680px) {
		.case-section {
			padding-inline: 16px;
		}

		.section-title {
			margin-bottom: 32px;
			font-size: 34px;
		}

		.stats-row {
			grid-template-columns: 1fr;
			border-radius: 24px;
		}

		.stats-row::before {
			width: 120px;
		}

		.stat-item {
			min-height: 178px;
			padding: 32px 24px;
		}

		.stat-item h3 {
			font-size: 58px;
		}

		.stat-item p,
		.case-note {
			font-size: 16px;
		}
	}
</style>
