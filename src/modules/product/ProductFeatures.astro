---
type Props = {
	features?: {
		title: string;
		description: string;
	}[];
};

const {
	features = [
		{
			title: "Медицинская точность",
			description:
				"8-электродная многочастотная BIA (5 частот: 5, 50, 100, 250, 500 кГц) с сегментарным анализом рук, ног и торса. Точность, сопоставимая с DEXA-сканерами.",
		},
	],
} = Astro.props as Props;
---

<section class="features bg-gradient-1 fade-up">
	<div class="container">
		<h2 class="section-title">
			<slot name="title" />
		</h2>
		<p class="section-subtitle"><slot name="subtitle" /></p>
		<div class="features-grid">
			{
				features.map(({ title, description }) => (
					<div class="feature-card">
						<h3 set:html={title} />
						<p set:html={description} />
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.features {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 96px 24px 112px;
	}

	.bg-gradient-1 {
		background:
			linear-gradient(135deg, rgba(2, 6, 23, 0.1) 0%, rgba(10, 25, 47, 0.28) 100%),
			radial-gradient(circle at 12% 12%, rgba(14, 165, 233, 0.12), transparent 34%);
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.section-title {
		max-width: 860px;
		margin: 0 auto 20px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(38px, 5vw, 52px);
		font-weight: 800;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-align: center;
		text-transform: uppercase;

		& > :global(.title-accent) {
			letter-spacing: -0.025em;
		}
	}

	.section-subtitle {
		max-width: 720px;
		margin: 0 auto 56px;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 18px;
		line-height: 1.6;
		letter-spacing: -0.015em;
		text-align: center;
		opacity: 0.82;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.feature-card {
		position: relative;
		min-height: 250px;
		padding: 36px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 32px;
		background: rgba(15, 23, 42, 0.42);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		backdrop-filter: blur(24px);
	}

	.feature-card::before {
		position: absolute;
		top: 0;
		left: 36px;
		width: 56px;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--color-brand-accent), #60a5fa);
		content: "";
	}

	.feature-card h3 {
		margin: 0 0 18px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: 24px;
		font-weight: 800;
		line-height: 1.18;
		letter-spacing: -0.025em;
	}

	.feature-card p {
		margin: 0;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.68;
		letter-spacing: -0.01em;
		opacity: 0.82;
	}

	@media (max-width: 992px) {
		.features {
			padding: 76px 20px 92px;
		}

		.features-grid {
			grid-template-columns: 1fr;
		}

		.feature-card {
			min-height: auto;
		}
	}

	@media (max-width: 560px) {
		.features {
			padding-inline: 16px;
		}

		.section-title {
			font-size: 34px;
		}

		.section-subtitle {
			margin-bottom: 36px;
			font-size: 16px;
		}

		.feature-card {
			padding: 30px 24px;
			border-radius: 24px;
		}

		.feature-card::before {
			left: 24px;
		}
	}
</style>
