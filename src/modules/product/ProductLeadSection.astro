---
import ProductLeadForm from "@components/lead-form/ProductLeadForm";

type Props = {
	sectionId?: string;
	formId?: string;
	submitLabel?: string;
	note?: string;
};

const {
	sectionId = "lead-form",
	formId = "m60LeadForm",
	submitLabel = "Отправить заявку",
	note = "Нажимая на кнопку, вы соглашаетесь с политикой обработки персональных данных",
} = Astro.props as Props;
---

<section class="lead-section" id={sectionId}>
	<div class="container">
		<div class="form-container">
			<div class="head">
				<h2 class="title">
					<slot name="title" />
				</h2>
				<p class="text"><slot name="text" /></p>
			</div>
			<ProductLeadForm client:load formId={formId} submitLabel={submitLabel} note={note} />
		</div>
	</div>
</section>

<style>
	.lead-section {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 96px 24px 112px;
		background:
			linear-gradient(135deg, rgba(2, 8, 23, 0.22) 0%, rgba(7, 20, 46, 0.38) 100%),
			radial-gradient(circle at 50% 20%, rgba(14, 165, 233, 0.12), transparent 34%);
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.form-container {
		width: min(100%, 680px);
		margin: 0 auto;
		padding: 44px 40px;
		border: 1px solid rgba(14, 165, 233, 0.2);
		border-radius: 32px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.68), rgba(15, 23, 42, 0.42)),
			radial-gradient(circle at 18% 0%, rgba(14, 165, 233, 0.12), transparent 52%);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.26);
		box-sizing: border-box;
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
	}

	.head {
		margin-bottom: 32px;
		text-align: center;
	}

	.title {
		margin: 0 0 14px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(28px, 4vw, 36px);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.035em;

		& > :global(.title-accent) {
			letter-spacing: -0.025em;
		}
	}

	.text {
		max-width: 560px;
		margin: 0 auto;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.62;
		letter-spacing: -0.01em;
		opacity: 0.82;
	}

	@media (max-width: 720px) {
		.lead-section {
			padding: 76px 20px 92px;
		}

		.form-container {
			padding: 34px 24px;
			border-radius: 26px;
		}
	}

	@media (max-width: 560px) {
		.lead-section {
			padding-inline: 16px;
		}

		.form-container {
			padding: 30px 20px;
			border-radius: 22px;
		}

		.title {
			font-size: 28px;
		}
	}
</style>
