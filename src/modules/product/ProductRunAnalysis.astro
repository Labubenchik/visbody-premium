---
type AnalysisCard = {
	title: string;
	description: string;
};

type Metric = {
	label: string;
	value: string;
	unit?: string;
};

type ProgressItem = {
	label: string;
	value: number;
};

type Props = {
	cards?: AnalysisCard[];
	metrics?: Metric[];
	progress?: ProgressItem[];
	footer?: string;
};

const {
	cards = [
		{
			title: "Оценка нагрузки на суставы",
			description: "Профилактика травм коленей и голеностопа",
		},
		{
			title: "Отклонение центра тяжести",
			description: "Коррекция баланса и осанки",
		},
		{
			title: "Угол коленного сустава",
			description: "Оптимизация амортизации и снижение ударной нагрузки",
		},
		{
			title: "Вертикальная амплитуда и длина шага",
			description: "Повышение эффективности бега",
		},
		{
			title: "Динамика симметрии движений",
			description: "Выявление асимметрии и дисбаланса",
		},
		{
			title: "23 AI-анализа в реальном времени",
			description: "Каждую минуту система обрабатывает 23 биомеханических параметра",
		},
	],
	metrics = [
		{ label: "Угол колена", value: "18.4°", unit: "±0.3" },
		{ label: "Верт. амплитуда", value: "12.7", unit: "cm" },
		{ label: "Длина шага", value: "1.18", unit: "m" },
		{ label: "Симметрия", value: "97.8", unit: "%" },
	],
	progress = [
		{ label: "Нагрузка левый сустав", value: 42 },
		{ label: "Нагрузка правый сустав", value: 38 },
		{ label: "Эффективность бега", value: 86 },
	],
	footer = "Sampling rate: 60Hz | Latency: <50ms | AI confidence: 98.3%",
} = Astro.props as Props;
---

<section class="run-analysis">
	<div class="container">
		<div class="analysis-grid">
			<div class="content">
				<h2 class="title">
					<slot name="title" />
				</h2>
				<p class="text"><slot name="text" /></p>

				<div class="cards">
					{
						cards.map(({ title, description }) => (
							<div class="card">
								<h4>{title}</h4>
								<p>{description}</p>
							</div>
						))
					}
				</div>
			</div>

			<div class="visual">
				<div class="dashboard">
					<div class="dashboard-header">
						<span>Visbody BioScan v.4.2</span>
						<span>Live stream | 60Hz</span>
					</div>

					<div class="metrics-panel">
						<div class="metrics-row">
							{
								metrics.map(({ label, value, unit }) => (
									<div class="metric-card">
										<div class="metric-label">{label}</div>
										<div class="metric-value">
											{value} {unit && <span>{unit}</span>}
										</div>
									</div>
								))
							}
						</div>

						<div class="progress-list">
							{
								progress.map(({ label, value }) => (
									<div class="progress-item">
										<div class="progress-header">
											<span>{label}</span>
											<span>{value}%</span>
										</div>
										<div class="progress-track" aria-hidden="true">
											<div class="progress-fill" style={`width: ${value}%`} />
										</div>
									</div>
								))
							}
						</div>
					</div>

					<div class="dashboard-footer">{footer}</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.run-analysis {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 96px 24px 112px;
		background:
			linear-gradient(135deg, rgba(2, 6, 23, 0.1) 0%, rgba(10, 25, 47, 0.28) 100%),
			radial-gradient(circle at 82% 22%, rgba(14, 165, 233, 0.12), transparent 34%);
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.analysis-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(360px, 0.92fr);
		align-items: center;
		gap: 56px;
	}

	.title {
		margin: 0;
		max-width: 760px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(38px, 5vw, 52px);
		font-weight: 800;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-transform: uppercase;

		& > :global(.title-accent) {
			letter-spacing: -0.025em;
		}
	}

	.text {
		max-width: 680px;
		margin: 22px 0 34px;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 17px;
		line-height: 1.68;
		letter-spacing: -0.01em;
		opacity: 0.82;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.card {
		position: relative;
		min-height: 136px;
		padding: 24px;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 24px;
		background: rgba(15, 23, 42, 0.42);
		box-shadow: 0 18px 54px rgba(0, 0, 0, 0.18);
		backdrop-filter: blur(18px);

		&::before {
			position: absolute;
			top: 0;
			left: 24px;
			width: 44px;
			height: 3px;
			border-radius: 999px;
			background: linear-gradient(90deg, var(--color-brand-accent), #60a5fa);
			content: "";
		}

		& h4 {
			margin: 0 0 10px;
			color: #ffffff;
			font-family: var(--font-sans);
			font-size: 18px;
			font-weight: 800;
			line-height: 1.2;
			letter-spacing: -0.025em;
		}

		& p {
			margin: 0;
			color: rgba(203, 213, 225, 0.76);
			font-family: var(--font-sans);
			font-size: 14px;
			line-height: 1.55;
			letter-spacing: -0.01em;
		}
	}

	.visual {
		min-width: 0;
	}

	.dashboard {
		width: min(100%, 520px);
		margin: 0 auto;
		overflow: hidden;
		border: 1px solid rgba(14, 165, 233, 0.18);
		border-radius: 28px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.74), rgba(15, 23, 42, 0.42)),
			radial-gradient(circle at 18% 8%, rgba(14, 165, 233, 0.14), transparent 56%);
		box-shadow: 0 28px 88px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(22px);
	}

	.dashboard-header,
	.dashboard-footer {
		display: flex;
		justify-content: space-between;
		gap: 18px;
		padding: 18px 22px;
		color: rgba(203, 213, 225, 0.68);
		font-family: var(--font-sans);
		font-size: 10px;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.dashboard-header {
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	}

	.dashboard-footer {
		display: block;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		color: rgba(125, 211, 252, 0.78);
		text-align: center;
	}

	.metrics-panel {
		padding: 22px;
	}

	.metrics-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.metric-card {
		min-height: 92px;
		padding: 18px;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 18px;
		background: rgba(2, 6, 23, 0.34);
		box-sizing: border-box;
	}

	.metric-label {
		margin-bottom: 12px;
		color: rgba(148, 163, 184, 0.74);
		font-family: var(--font-sans);
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.metric-value {
		color: #7dd3fc;
		font-family: var(--font-sans);
		font-size: 28px;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.04em;

		& span {
			color: rgba(203, 213, 225, 0.68);
			font-size: 14px;
			letter-spacing: -0.01em;
		}
	}

	.progress-list {
		display: grid;
		gap: 18px;
		margin-top: 24px;
	}

	.progress-header {
		display: flex;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 8px;
		color: rgba(203, 213, 225, 0.74);
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.progress-track {
		height: 7px;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(148, 163, 184, 0.18);
	}

	.progress-fill {
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, #0ea5e9, #60a5fa);
		box-shadow: 0 0 18px rgba(14, 165, 233, 0.34);
	}

	@media (max-width: 1040px) {
		.analysis-grid {
			grid-template-columns: 1fr;
			gap: 42px;
		}

		.title,
		.text {
			max-width: none;
			text-align: center;
		}
	}

	@media (max-width: 720px) {
		.run-analysis {
			padding: 76px 20px 92px;
		}

		.cards,
		.metrics-row {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.run-analysis {
			padding-inline: 16px;
		}

		.title {
			font-size: 34px;
		}

		.card {
			min-height: auto;
			padding: 22px;
			border-radius: 20px;
		}

		.dashboard {
			border-radius: 22px;
		}

		.dashboard-header {
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
