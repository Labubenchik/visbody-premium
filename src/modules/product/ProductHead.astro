---
import m60Image from "@modules/home/hero-section/assets/m-60.webp";
import Button from "@ui/button/Button";

type Action = {
	label: string;
	href?: string;
	id?: string;
	withArrow?: boolean;
};

type Props = {
	primaryAction?: Action;
	secondaryAction?: Action;
	imageSrc?: string;
	imageAlt?: string;
};

const {
	primaryAction = { label: "Запросить цену", id: "priceBtnM60" },
	secondaryAction = { label: "Узнать технологии", href: "#tech" },
	imageSrc = m60Image.src,
	imageAlt = "Visbody M60",
} = Astro.props as Props;
---

<section class="product-hero nav-bar-gap">
	<div class="container">
		<div class="hero-row">
			<div class="hero-text">
				<span class="eyebrow"><slot name="eyebrow" /></span>
				<h1 class="hero-title">
					<slot name="title" />
				</h1>
				<p class="hero-p"><slot name="description" /></p>
				<div class="hero-actions">
					<Button
						href={primaryAction.href}
						id={primaryAction.id}
						variant="primary"
						withArrow={primaryAction.withArrow}
						fullWidthOnMobile>
						{primaryAction.label}
					</Button>
					<Button
						href={secondaryAction.href}
						id={secondaryAction.id}
						variant="secondary"
						withArrow={secondaryAction.withArrow}
						fullWidthOnMobile>
						{secondaryAction.label}
					</Button>
				</div>
			</div>
			<div class="hero-image">
				<div class="mockup-scanner">
					<img src={imageSrc} width="520" height="520" alt={imageAlt} loading="eager" decoding="async" />
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.product-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 72px 24px 104px;
	}

	.product-hero::before {
		position: absolute;
		inset: -20% -10%;
		z-index: -2;
		background:
			radial-gradient(circle at 82% 18%, rgba(14, 165, 233, 0.24), transparent 34%),
			radial-gradient(circle at 18% 78%, rgba(37, 99, 235, 0.18), transparent 32%);
		content: "";
	}

	.product-hero::after {
		position: absolute;
		inset: auto 0 0;
		z-index: -1;
		height: 45%;
		background: linear-gradient(to top, rgba(2, 6, 23, 0.62), transparent);
		content: "";
		pointer-events: none;
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.hero-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 48px;
	}

	.hero-text {
		flex: 1 1 0;
		max-width: 640px;
	}

	.eyebrow {
		margin-bottom: 22px;
	}

	.hero-title {
		margin: 0 0 26px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(42px, 6vw, 56px);
		font-weight: 800;
		line-height: 1.04;
		letter-spacing: -0.04em;
		text-transform: uppercase;

		& > :global(.title-accent) {
			letter-spacing: -0.025em;
		}
	}

	.hero-p {
		max-width: 590px;
		margin: 0 0 38px;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 18px;
		line-height: 1.72;
		letter-spacing: -0.015em;
		opacity: 0.86;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	.hero-image {
		flex: 1 1 0;
		display: flex;
		justify-content: center;
		min-width: 0;
	}

	.mockup-scanner {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: min(100%, 480px);
		aspect-ratio: 0.82;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 32px;
		background: rgba(15, 23, 42, 0.34);
		box-shadow:
			0 32px 90px rgba(0, 0, 0, 0.34),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(24px);
	}

	.mockup-scanner img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: drop-shadow(0 28px 52px rgba(14, 165, 233, 0.16));
	}

	@media (max-width: 992px) {
		.product-hero {
			padding: 56px 20px 86px;
		}

		.hero-row {
			flex-direction: column;
			text-align: center;
		}

		.hero-p {
			margin-right: auto;
			margin-left: auto;
		}

		.hero-actions {
			justify-content: center;
		}

		.mockup-scanner {
			max-width: 420px;
			aspect-ratio: 0.9;
		}
	}

	@media (max-width: 560px) {
		.product-hero {
			padding-inline: 16px;
		}

		.hero-title {
			font-size: 36px;
		}

		.hero-p {
			font-size: 16px;
		}

		.hero-actions {
			align-items: stretch;
			flex-direction: column;
		}
	}
</style>
