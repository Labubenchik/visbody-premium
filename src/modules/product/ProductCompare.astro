---
type CompareCell = {
	value: string;
	highlight?: boolean;
};

type CompareRow = {
	parameter: string;
	first: CompareCell;
	second: CompareCell;
};

type Props = {
	columns?: {
		parameter: string;
		first: string;
		second: string;
	};
	rows?: CompareRow[];
};

const {
	columns = {
		parameter: "Параметр",
		first: "Visbody M60",
		second: "Visbody S30",
	},
	rows = [
		{
			parameter: "Полный цикл сканирования",
			first: { value: "40 секунд", highlight: true },
			second: { value: "45 секунд (с измерением роста)" },
		},
	],
} = Astro.props as Props;
---

<section class="compare-section">
	<div class="container">
		<h2 class="section-title">
			<slot name="title" />
		</h2>
		<p class="section-subtitle"><slot name="subtitle" /></p>

		<div class="compare-shell">
			<table class="compare-table">
				<thead>
					<tr>
						<th>{columns.parameter}</th>
						<th>{columns.first}</th>
						<th>{columns.second}</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map(({ parameter, first, second }) => (
							<tr>
								<td class="parameter">{parameter}</td>
								<td
									class:list={["compare-value", { highlight: first.highlight }]}
									data-label={columns.first}>
									{first.value}
								</td>
								<td class="compare-value" data-label={columns.second}>
									{second.value}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	.compare-section {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 96px 24px 112px;
		background:
			linear-gradient(135deg, rgba(2, 8, 23, 0.22) 0%, rgba(7, 20, 46, 0.38) 100%),
			radial-gradient(circle at 82% 18%, rgba(96, 165, 250, 0.1), transparent 34%);
	}

	.container {
		width: min(100%, 1200px);
		margin: 0 auto;
	}

	.section-title {
		max-width: 980px;
		margin: 0 auto 20px;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(38px, 5vw, 52px);
		font-weight: 800;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-align: center;
		text-transform: uppercase;

		& > :global(.title-accent) {
			letter-spacing: -0.025em;
		}
	}

	.section-subtitle {
		max-width: 760px;
		margin: 0 auto 56px;
		color: #cbd5e1;
		font-family: var(--font-sans);
		font-size: 18px;
		line-height: 1.6;
		letter-spacing: -0.015em;
		text-align: center;
		opacity: 0.82;

		& > :global(.title-accent) {
			color: var(--color-brand-accent);
		}
	}

	.compare-shell {
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 32px;
		background: rgba(15, 23, 42, 0.42);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
	}

	.compare-table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-sans);

		& th {
			padding: 22px 24px;
			border-bottom: 1px solid rgba(14, 165, 233, 0.18);
			background: rgba(14, 165, 233, 0.09);
			color: #7dd3fc;
			font-size: 18px;
			font-weight: 800;
			letter-spacing: 0.12em;
			line-height: 1.35;
			text-align: left;
			text-transform: uppercase;
		}

		& td {
			padding: 20px 24px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			color: #ffffff;
			font-size: 16px;
			font-weight: 460;
			line-height: 1.5;
			letter-spacing: -0.01em;
			vertical-align: middle;

			&.parameter {
				color: #94a3b8;
			}
		}

		& tbody tr:last-child td {
			border-bottom: 0;
		}
	}

	.highlight {
		position: relative;
		background:
			linear-gradient(90deg, rgba(14, 165, 233, 0.18), rgba(14, 165, 233, 0.06)), rgba(14, 165, 233, 0.04);

		&::before {
			position: absolute;
			top: 14px;
			bottom: 14px;
			left: 0;
			width: 3px;
			border-radius: 999px;
			background: var(--color-brand-accent);
			content: "";
		}
	}

	@media (max-width: 992px) {
		.compare-section {
			padding: 76px 20px 92px;
		}
	}

	@media (max-width: 760px) {
		.compare-section {
			padding-inline: 16px;
		}

		.section-title {
			font-size: 34px;
		}

		.section-subtitle {
			margin-bottom: 36px;
			font-size: 16px;
		}

		.compare-shell {
			border-radius: 24px;
		}

		.compare-table,
		.compare-table thead,
		.compare-table tbody,
		.compare-table tr,
		.compare-table th,
		.compare-table td {
			display: block;
		}

		.compare-table thead {
			display: none;
		}

		.compare-table tr {
			padding: 22px 20px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		}

		.compare-table tbody tr:last-child {
			border-bottom: 0;
		}

		.compare-table td {
			width: auto;
			padding: 0;
			border-bottom: 0;
		}

		.parameter {
			margin-bottom: 16px;
			color: #ffffff;
			font-size: 13px;
		}

		.compare-value {
			position: relative;
			padding: 13px 14px 13px 110px;
			border-radius: 16px;
			background: rgba(255, 255, 255, 0.04);
			font-size: 15px;
		}

		.compare-value + .compare-value {
			margin-top: 10px;
		}

		.compare-value::after {
			position: absolute;
			top: 14px;
			left: 14px;
			max-width: 82px;
			color: #7dd3fc;
			content: attr(data-label);
			font-size: 10px;
			font-weight: 800;
			letter-spacing: 0.08em;
			line-height: 1.25;
			text-transform: uppercase;
		}

		.highlight::before {
			top: 10px;
			bottom: 10px;
		}
	}
</style>
