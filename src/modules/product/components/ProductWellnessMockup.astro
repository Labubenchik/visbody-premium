---
type Props = {
	title?: string;
	metric?: string;
	caption?: string;
	bars?: number[];
};

const {
	title = "Анализ состава тела M60",
	metric = "Динамика",
	caption = "Облачная платформа WellnessHub с Kuafu AI 3.5",
	bars = [40, 85, 60, 95, 70],
} = Astro.props as Props;
---

<aside class="wellness-card" aria-label="WellnessHub dashboard">
	<div class="widget">
		<div class="widget-header">
			<span class="widget-title">{title}</span>
			<span class="widget-metric">{metric}</span>
		</div>
		<div class="chart" aria-hidden="true">
			{
				bars.map((height) => (
					<span class="bar" style={`--bar-height: ${height}px`}>
						<span class="bar-fill" />
					</span>
				))
			}
		</div>
	</div>
	<p class="caption">{caption}</p>
</aside>

<style>
	.wellness-card {
		width: min(100%, 480px);
		margin: 0 auto;
		padding: 24px;
		border: 1px solid rgba(14, 165, 233, 0.16);
		border-radius: 24px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.4)),
			radial-gradient(circle at 18% 8%, rgba(14, 165, 233, 0.13), transparent 56%);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.24);
		box-sizing: border-box;
		backdrop-filter: blur(18px);
	}

	.widget {
		padding: 22px;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 18px;
		background: rgba(2, 6, 23, 0.32);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);

		.widget-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
			margin-bottom: 24px;
		}
	}

	.widget-title,
	.widget-metric {
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.widget-title {
		color: rgba(203, 213, 225, 0.72);
	}

	.widget-metric {
		color: var(--color-brand-accent);
		text-align: right;
	}

	.chart {
		display: flex;
		align-items: flex-end;
		gap: 12px;
		height: 136px;
		padding: 16px 4px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.bar {
		position: relative;
		display: block;
		flex: 1;
		height: var(--bar-height);
		min-height: 32px;
		overflow: hidden;
		border-radius: 8px 8px 3px 3px;
		background: rgba(14, 165, 233, 0.12);

		&::before {
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 40%);
			content: "";
		}
	}

	.bar-fill {
		position: absolute;
		inset: 0;
		display: block;
		border-radius: inherit;
		background: linear-gradient(180deg, #60a5fa 0%, var(--color-brand-accent) 54%, #2563eb 100%);
		box-shadow: 0 0 22px rgba(14, 165, 233, 0.32);
	}

	.caption {
		margin: 18px 0 0;
		color: rgba(203, 213, 225, 0.72);
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.45;
		letter-spacing: -0.01em;
		text-align: center;
	}

	@media (max-width: 560px) {
		.wellness-card {
			padding: 18px;
			border-radius: 20px;
		}

		.widget {
			padding: 18px;

			.widget-header {
				align-items: flex-start;
				flex-direction: column;
				gap: 8px;
				margin-bottom: 20px;
			}
		}

		.widget-metric {
			text-align: left;
		}

		.chart {
			gap: 9px;
			height: 124px;
		}
	}
</style>
