---
const metrics = [
	{
		value: "48+",
		label: "метрик",
	},
	{
		value: "98%",
		label: "точность",
	},
];

const progress = [
	{
		label: "Мышечная масса",
		value: 83,
		color: "cyan",
	},
	{
		label: "Жировая масса",
		value: 24,
		color: "orange",
	},
];
---

<aside class="dashboard" aria-label="WellnessHub AI Dashboard">
	<header class="header">
		<h3 class="brand">WellnessHub</h3>
		<span class="meta">AI Dashboard</span>
	</header>

	<div class="metrics">
		{
			metrics.map(({ value, label }) => (
				<div class="metric">
					<strong>{value}</strong>
					<span>{label}</span>
				</div>
			))
		}
	</div>

	<div class="progress-list">
		{
			progress.map(({ label, value, color }) => (
				<div class="progress">
					<div class="progress-top">
						<span>{label}</span>
						<strong>{value}%</strong>
					</div>
					<div class="track" aria-hidden="true">
						<span class:list={["bar", color]} style={`width: ${value}%`} />
					</div>
				</div>
			))
		}
	</div>

	<div class="insight">DeepSeek AI: перспективные рекомендации на основе ваших данных</div>
</aside>

<style>
	.dashboard {
		width: min(100%, 360px);
		margin: 0 auto;
		padding: 28px 28px 30px;
		border: 1px solid rgba(14, 165, 233, 0.16);
		border-radius: 16px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.4)),
			radial-gradient(circle at 18% 10%, rgba(14, 165, 233, 0.12), transparent 58%);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		box-sizing: border-box;
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 26px;
	}

	.brand,
	.meta {
		margin: 0;
		font-size: 0.625rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.brand {
		color: #38bdf8;
	}

	.meta {
		color: rgba(148, 163, 184, 0.58);
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.metric {
		min-height: 72px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		background: rgba(14, 165, 233, 0.12);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.metric strong {
		color: #38bdf8;
		font-size: 1.375rem;
		font-weight: 800;
		line-height: 1;
		margin-left: 4px;
	}

	.metric span {
		margin-top: 6px;
		color: rgba(203, 213, 225, 0.66);
		font-size: 0.5625rem;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
	}

	.progress-list {
		display: grid;
		gap: 16px;
		margin-top: 26px;
	}

	.progress-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 8px;
		color: rgba(226, 232, 240, 0.7);
		font-size: 12px;
		font-weight: 500;
		line-height: 1;
	}

	.progress-top strong {
		color: rgba(226, 232, 240, 0.78);
		font-size: inherit;
	}

	.track {
		height: 5px;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(148, 163, 184, 0.18);
	}

	.bar {
		display: block;
		height: 100%;
		border-radius: inherit;
	}

	.bar.cyan {
		background: linear-gradient(90deg, #0ea5e9, #38bdf8);
		box-shadow: 0 0 18px rgba(14, 165, 233, 0.3);
	}

	.bar.orange {
		background: linear-gradient(90deg, #f97316, #fbbf24);
		box-shadow: 0 0 18px rgba(249, 115, 22, 0.24);
	}

	.insight {
		margin-top: 24px;
		padding: 14px 18px;
		border-radius: 8px;
		background: rgba(14, 165, 233, 0.12);
		color: #38bdf8;
		font-size: 12px;
		font-weight: 600;
		line-height: 1.45;
		text-align: center;
	}

	@media (max-width: 560px) {
		.dashboard {
			padding: 24px 20px 26px;
			border-radius: 14px;
		}

		.header {
			gap: 14px;
		}
	}
</style>
