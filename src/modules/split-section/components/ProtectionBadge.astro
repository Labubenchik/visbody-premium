---
const badges = ["AWS Cloud", "GDPR Ready", "256-bit SSL"];
---

<aside class="card" aria-label="Защита данных">
	<div class="mark">[ Защита ]</div>
	<div class="badges">
		{badges.map((badge) => <span class="badge">{badge}</span>)}
	</div>
</aside>

<style>
	.card {
		width: min(100%, 360px);
		margin: 0 auto;
		padding: 46px 32px 40px;
		border: 1px solid rgba(14, 165, 233, 0.16);
		border-radius: 16px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.62), rgba(15, 23, 42, 0.34)),
			radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.1), transparent 64%);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		box-sizing: border-box;
	}

	.mark {
		color: rgba(255, 255, 255, 0.72);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 400;
		line-height: 1;
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px;
		margin-top: 34px;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		min-height: 26px;
		padding: 0 14px;
		border: 1px solid rgba(14, 165, 233, 0.2);
		border-radius: 999px;
		background: rgba(14, 165, 233, 0.16);
		color: #38bdf8;
		font-size: 0.625rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	@media (max-width: 560px) {
		.card {
			padding: 40px 22px 34px;
			border-radius: 14px;
		}
	}
</style>
