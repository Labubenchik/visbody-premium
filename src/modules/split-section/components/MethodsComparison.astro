---
const methods = [
	{
		label: "Гибридный BIA+BDA",
		value: 95,
	},
	{
		label: "Традиционный BIA",
		value: 82,
	},
	{
		label: "Ручные замеры",
		value: 68,
	},
];
---

<aside class="card" aria-label="Сравнение методов">
	<h3 class="title">Сравнение методов</h3>
	<div class="divider"></div>
	<div class="list">
		{
			methods.map(({ label, value }) => (
				<div class="row">
					<span class="label">{label}</span>
					<div class="track" aria-hidden="true">
						<span class="bar" style={`width: ${value}%`} />
					</div>
					<span class="value">{value}%</span>
				</div>
			))
		}
	</div>
	<div class="divider"></div>
	<p class="note">*Относительная точность измерения композиции тела и общего процента сегментов.</p>
</aside>

<style>
	.card {
		width: min(100%, 410px);
		margin: 0 auto;
		padding: 30px 32px 26px;
		border: 1px solid rgba(14, 165, 233, 0.16);
		border-radius: 16px;
		background:
			linear-gradient(180deg, rgba(15, 23, 42, 0.62), rgba(15, 23, 42, 0.34)),
			radial-gradient(circle at 22% 0%, rgba(14, 165, 233, 0.11), transparent 58%);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
		backdrop-filter: blur(18px);
		box-sizing: border-box;
	}

	.divider {
		width: calc(100% + 64px);
		height: 1px;
		margin: 24px -32px;
		background: rgba(14, 165, 233, 0.16);
	}

	.title {
		color: #0ea5e9;
		font-size: 14px;
		font-weight: 800;
		line-height: 1;
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.list {
		display: grid;
		gap: 18px;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 6px 12px;
		align-items: center;
	}

	.label {
		color: rgba(226, 232, 240, 0.76);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.25;
		grid-column: 1 / -1;
	}

	.track {
		height: 6px;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(148, 163, 184, 0.18);
	}

	.bar {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, #0ea5e9, #38bdf8);
		box-shadow: 0 0 18px rgba(14, 165, 233, 0.32);
	}

	.value {
		color: #38bdf8;
		font-size: 0.6875rem;
		font-weight: 800;
		line-height: 1;
		text-align: right;
	}

	.note {
		margin: 0 auto;
		max-width: 270px;
		color: rgba(148, 163, 184, 0.58);
		font-size: 12px;
		font-weight: 400;
		line-height: 1;
		text-align: center;
	}

	@media (max-width: 560px) {
		.card {
			padding: 26px 22px 24px;
			border-radius: 14px;
		}

		.row {
			grid-template-columns: 1fr 1.2fr 34px;
			gap: 10px;
		}
	}
</style>
