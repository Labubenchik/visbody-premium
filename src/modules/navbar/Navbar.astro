---
import logo from "@assets/logo/logo.svg";
import { ROUTES } from "@/static-data";

const NAV_LINKS = [ROUTES.catalog, ROUTES.technology, ROUTES.cases, ROUTES.blog] as const;
const SOLUTION_LINKS = [ROUTES.solutions.children.fitness, ROUTES.solutions.children.medical] as const;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrent = (href: string) => {
	const normalizedHref = href.replace(/\/$/, "") || "/";

	return currentPath === normalizedHref || (normalizedHref !== "/" && currentPath.startsWith(`${normalizedHref}/`));
};
---

<nav class="navbar" data-script="navbar" aria-label="Основная навигация">
	<div class="navbar__inner">
		<div class="navbar__bar">
			<a href="/" class="navbar__logo" aria-label="Visbody, на главную">
				<img src={logo.src} width="304" height="70" alt="Visbody" />
			</a>

			<div class="navbar__desktop-menu">
				<details class="navbar__dropdown">
					<summary class="navbar__link navbar__summary">Решения</summary>
					<div class="navbar__dropdown-panel" aria-label="Разделы решений">
						{
							SOLUTION_LINKS.map((link) => (
								<a
									href={link.href}
									class="navbar__dropdown-link"
									aria-current={isCurrent(link.href) ? "page" : undefined}>
									{link.label}
								</a>
							))
						}
					</div>
				</details>
				{
					NAV_LINKS.map((link) => (
						<a
							href={link.href}
							class="navbar__link"
							aria-current={isCurrent(link.href) ? "page" : undefined}>
							{link.label}
						</a>
					))
				}
				<a
					href={ROUTES.contact.href}
					class="navbar__contact"
					aria-current={isCurrent(ROUTES.contact.href) ? "page" : undefined}>
					{ROUTES.contact.label}
				</a>
			</div>

			<div class="navbar__actions">
				<details class="navbar__mobile-menu">
					<summary class="navbar__menu-toggle" aria-label="Открыть меню">
						<span class="navbar__menu-icon" aria-hidden="true"></span>
					</summary>
					<div class="navbar__mobile-panel">
						<details class="navbar__mobile-group">
							<summary class="navbar__mobile-link navbar__mobile-summary">Решения</summary>
							<div class="navbar__mobile-submenu">
								{
									SOLUTION_LINKS.map((link) => (
										<a
											href={link.href}
											class="navbar__mobile-sublink"
											aria-current={isCurrent(link.href) ? "page" : undefined}>
											{link.label}
										</a>
									))
								}
							</div>
						</details>
						{
							NAV_LINKS.map((link) => (
								<a
									href={link.href}
									class="navbar__mobile-link"
									aria-current={isCurrent(link.href) ? "page" : undefined}>
									{link.label}
								</a>
							))
						}
						<a
							href={ROUTES.contact.href}
							class="navbar__mobile-contact"
							aria-current={isCurrent(ROUTES.contact.href) ? "page" : undefined}>
							{ROUTES.contact.label}
						</a>
					</div>
				</details>
			</div>
		</div>
	</div>
</nav>

<script>
	const navbar = document.querySelector('[data-script="navbar"]');

	if (navbar) {
		const closeOpenMenus = (event: PointerEvent) => {
			const openMenus = navbar.querySelectorAll("details[open]");
			const clickedElement = event.target;

			openMenus.forEach((menu) => {
				if (clickedElement instanceof Node && !menu.contains(clickedElement)) {
					menu.removeAttribute("open");
				}
			});
		};

		document.addEventListener("click", closeOpenMenus);
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") {
				return;
			}

			navbar.querySelectorAll("details[open]").forEach((menu) => {
				menu.removeAttribute("open");
			});
		});
	}
</script>

<style>
	.navbar {
		position: fixed;
		z-index: 9999;
		top: 0;
		left: 0;
		width: 100%;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(2, 6, 23, 0.76);
		backdrop-filter: blur(24px);
	}

	.navbar__inner {
		width: min(100% - 32px, 1280px);
		margin: 0 auto;
	}

	.navbar__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 80px;
		gap: 24px;
	}

	.navbar__logo {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		border-radius: 12px;

		img {
			display: block;
			width: 180px;
			height: auto;
		}
	}

	.navbar__desktop-menu,
	.navbar__actions {
		display: flex;
		align-items: center;
	}

	.navbar__desktop-menu {
		gap: clamp(18px, 2.1vw, 32px);
		margin-left: auto;
		font-family: var(--font-sans);
	}

	.navbar__actions {
		gap: 12px;
	}

	.navbar__link,
	.navbar__contact,
	.navbar__dropdown-link,
	.navbar__mobile-link,
	.navbar__mobile-sublink,
	.navbar__mobile-contact {
		color: #cbd5e1;
		text-decoration: none;
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			color 0.25s ease,
			transform 0.25s ease;
	}

	.navbar__link,
	.navbar__summary {
		display: inline-flex;
		align-items: center;
		min-height: 80px;
		border-radius: 12px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.16em;
		line-height: 1;
		text-transform: uppercase;
	}

	.navbar__link:hover,
	.navbar__link:focus-visible,
	.navbar__link[aria-current="page"],
	.navbar__summary:hover,
	.navbar__dropdown[open] .navbar__summary {
		color: #7dd3fc;
	}

	.navbar__contact,
	.navbar__mobile-contact {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(14, 165, 233, 0.45);
		background: linear-gradient(135deg, var(--color-brand-accent) 0%, #2563eb 100%);
		box-shadow: 0 18px 48px rgba(14, 165, 233, 0.28);
		color: #ffffff;
		font-weight: 800;
		text-transform: uppercase;
	}

	.navbar__contact {
		min-height: 44px;
		padding: 14px 22px;
		border-radius: 16px;
		font-size: 12px;
		letter-spacing: 0.14em;
	}

	.navbar__contact:hover,
	.navbar__contact:focus-visible,
	.navbar__mobile-contact:hover,
	.navbar__mobile-contact:focus-visible {
		box-shadow: 0 22px 60px rgba(14, 165, 233, 0.38);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.navbar__dropdown,
	.navbar__mobile-menu,
	.navbar__mobile-group {
		position: relative;
	}

	.navbar__summary,
	.navbar__menu-toggle,
	.navbar__mobile-summary {
		list-style: none;
		cursor: pointer;
	}

	.navbar__summary::-webkit-details-marker,
	.navbar__menu-toggle::-webkit-details-marker,
	.navbar__mobile-summary::-webkit-details-marker {
		display: none;
	}

	.navbar__summary::after,
	.navbar__mobile-summary::after {
		content: "";
		width: 7px;
		height: 7px;
		margin-left: 10px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-2px) rotate(45deg);
		transition: transform 0.25s ease;
	}

	.navbar__dropdown[open] .navbar__summary::after,
	.navbar__mobile-group[open] .navbar__mobile-summary::after {
		transform: translateY(2px) rotate(225deg);
	}

	.navbar__dropdown-panel {
		position: absolute;
		top: calc(100% - 8px);
		left: -18px;
		width: 264px;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		background: rgba(10, 25, 48, 0.94);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42);
		backdrop-filter: blur(24px);
	}

	.navbar__dropdown,
	.navbar__mobile-menu {
		&::details-content {
			opacity: 0;
			transform: translateY(-20px);
			transition:
				transform 200ms ease-out,
				opacity 200ms ease-out,
				content-visibility 200ms allow-discrete;
			interpolate-size: allow-keywords;
		}

		&[open]::details-content {
			transform: translateY(0);
			opacity: 1;
		}
	}

	.navbar__dropdown-link {
		display: block;
		padding: 14px 16px;
		border-radius: 12px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.navbar__dropdown-link:hover,
	.navbar__dropdown-link:focus-visible,
	.navbar__dropdown-link[aria-current="page"] {
		color: #7dd3fc;
	}

	.navbar__dropdown-link:hover,
	.navbar__dropdown-link:focus-visible {
		background: rgba(255, 255, 255, 0.06);
		color: #7dd3fc;
	}

	.navbar__menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px;
		background: rgba(15, 23, 42, 0.4);
		color: #cbd5e1;
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			color 0.25s ease,
			transform 0.25s ease;
	}

	.navbar__mobile-menu[open] .navbar__menu-toggle {
		border-color: rgba(14, 165, 233, 0.45);
		background: rgba(14, 165, 233, 0.12);
		color: #7dd3fc;
		transform: translateY(-1px);
	}

	.navbar__mobile-menu {
		display: none;
	}

	.navbar__menu-icon,
	.navbar__menu-icon::before,
	.navbar__menu-icon::after {
		display: block;
		width: 18px;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.25s ease,
			opacity 0.25s ease;
	}

	.navbar__menu-icon {
		position: relative;
	}

	.navbar__menu-icon::before,
	.navbar__menu-icon::after {
		content: "";
		position: absolute;
		left: 0;
	}

	.navbar__menu-icon::before {
		top: -6px;
	}

	.navbar__menu-icon::after {
		top: 6px;
	}

	.navbar__mobile-menu[open] .navbar__menu-icon {
		background: transparent;
	}

	.navbar__mobile-menu[open] .navbar__menu-icon::before {
		transform: translateY(6px) rotate(45deg);
	}

	.navbar__mobile-menu[open] .navbar__menu-icon::after {
		transform: translateY(-6px) rotate(-45deg);
	}

	.navbar__mobile-panel {
		position: absolute;
		top: calc(100% + 14px);
		right: 0;
		width: min(calc(100vw - 32px), 360px);
		padding: 12px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 18px;
		background: rgba(10, 25, 48, 0.96);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.46);
		backdrop-filter: blur(24px);
	}

	.navbar__mobile-link,
	.navbar__mobile-summary,
	.navbar__mobile-sublink,
	.navbar__mobile-contact {
		width: 100%;
		border-radius: 12px;
		font-family: var(--font-sans);
	}

	.navbar__mobile-link,
	.navbar__mobile-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.14em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.navbar__mobile-link:hover,
	.navbar__mobile-link:focus-visible,
	.navbar__mobile-link[aria-current="page"],
	.navbar__mobile-summary:hover,
	.navbar__mobile-group[open] .navbar__mobile-summary {
		background: rgba(255, 255, 255, 0.06);
		color: #7dd3fc;
	}

	.navbar__mobile-submenu {
		display: grid;
		gap: 4px;
		padding: 0 0 8px 12px;
	}

	.navbar__mobile-sublink {
		display: block;
		padding: 13px 16px;
		color: #94a3b8;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.navbar__mobile-sublink:hover,
	.navbar__mobile-sublink:focus-visible,
	.navbar__mobile-sublink[aria-current="page"] {
		background: rgba(14, 165, 233, 0.1);
		color: #7dd3fc;
	}

	.navbar__mobile-contact {
		min-height: 48px;
		margin-top: 8px;
		font-size: 12px;
		letter-spacing: 0.14em;
	}

	.navbar a:focus-visible,
	.navbar summary:focus-visible {
		outline: 2px solid rgba(14, 165, 233, 0.72);
		outline-offset: 3px;
	}

	@media (max-width: 1020px) {
		.navbar__desktop-menu {
			display: none;
		}

		.navbar__mobile-menu {
			display: block;
		}
	}

	@media (max-width: 560px) {
		.navbar__inner {
			width: min(100% - 24px, 1280px);
		}

		.navbar__bar {
			min-height: 72px;
			gap: 12px;
		}

		.navbar__logo img {
			width: 150px;
		}

		.navbar__actions {
			gap: 8px;
		}

		.navbar__menu-toggle {
			width: 42px;
			height: 42px;
			border-radius: 13px;
		}

		.navbar__mobile-panel {
			right: -2px;
			width: calc(100vw - 24px);
			border-radius: 16px;
		}
	}
</style>
