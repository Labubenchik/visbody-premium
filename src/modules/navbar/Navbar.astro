---
import logo from "@assets/logo/logo.svg";
import { ShoppingCart } from "@lucide/astro";
import { ROUTES } from "@/static-data";

const NAV_LINKS = [ROUTES.catalog, ROUTES.technology, ROUTES.cases, ROUTES.blog] as const;
const SOLUTION_LINKS = [ROUTES.solutions.children.fitness, ROUTES.solutions.children.medical] as const;
---

<nav class="fixed top-0 w-full z-[9999] backdrop-blur-xl border-b border-white/5 bg-[#020617]/70">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between h-20 items-center">
			<a
				href="/"
				class="flex items-center gap-3 text-2xl font-sans font-extrabold uppercase group tracking-tighter">
				<img class="w-[180px]" src={logo.src} width="304" height="70" />
			</a>

			<div
				class="hidden lg:flex gap-8 items-center uppercase font-sans text-[10px] tracking-[0.2em] font-extrabold">
				<div class="group relative">
					<span
						class="text-slate-300 hover:text-brand-accent transition-colors cursor-pointer py-8 inline-block">
						Решения
					</span>
					<div
						class="absolute top-[90%] left-0 w-64 bg-[#0a1930] border border-white/10 p-3 hidden group-hover:block backdrop-blur-3xl shadow-2xl rounded-2xl">
						{
							SOLUTION_LINKS.map((link) => (
								<a
									href={link.href}
									class="block px-6 py-4 text-slate-300 hover:bg-white/5 hover:text-brand-accent transition-all mb-1 rounded-xl">
									{link.label}
								</a>
							))
						}
					</div>
				</div>
				{
					NAV_LINKS.map((link) => (
						<a href={link.href} class="text-slate-300 hover:text-brand-accent transition-colors">
							{link.label}
						</a>
					))
				}
				<a
					href={ROUTES.contact.href}
					class="bg-brand-accent text-white px-6 py-3 rounded-full hover:bg-blue-600 transition-all ml-4 shadow-lg shadow-blue-500/25">
					{ROUTES.contact.label}
				</a>
			</div>

			<div class="flex gap-4 items-center">
				<a href="/cart" class="relative text-slate-400 hover:text-brand-accent transition-colors mt-1">
					<ShoppingCart size={24} />
					<span
						class="absolute -top-2 -right-2 bg-brand-accent text-[10px] font-bold w-4 h-4 flex items-center justify-center rounded-full text-white shadow-md">
						0
					</span>
				</a>
			</div>
		</div>
	</div>
</nav>
