---
import MainWrapTL from "@/layouts/MainWrapTL.astro";
import Layout from "@/layouts/Layout.astro";
import LeadForm from "@components/lead-form/LeadForm";
import { Activity, ArrowRight, BrainCircuit, FileCheck, ShieldCheck } from "@lucide/astro";
---

<Layout>
	<MainWrapTL>
		<div class="relative pb-24 text-white min-h-screen">
			<div
				class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-500/10 blur-[120px] rounded-full pointer-events-none">
			</div>

			<section class="py-24 text-center px-4 relative z-10">
				<div
					class="inline-block border border-blue-500/50 rounded-full text-blue-500 px-4 py-1.5 uppercase font-dot text-xs mb-6 bg-blue-500/10 tracking-[0.3em]">
					Medical Solution
				</div>
				<h1 class="text-5xl md:text-7xl font-dot uppercase tracking-tighter mb-8 text-white">
					Для{" "}
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-white">
						медицинских
					</span>{" "}
					центров
				</h1>
				<p class="text-xl text-gray-400 font-sans max-w-2xl mx-auto uppercase tracking-widest leading-relaxed">
					Научно-обоснованный подход к анализу состава тела (BIA) и оценке функций опорно-двигательного
					аппарата.
				</p>
			</section>

			<section class="py-20 grid grid-cols-1 md:grid-cols-2 gap-12 max-w-6xl mx-auto px-4">
				<div class="bg-blue-500/5 border border-white/5 rounded-4xl p-10 relative overflow-hidden">
					<h3 class="text-gray-500 font-dot uppercase text-xl mb-4">// Проблема</h3>
					<p class="text-2xl font-sans font-light text-white leading-relaxed">
						Врачам не хватает объективных, валидируемых аппаратных данных для точной оценки прогресса
						реабилитации пациента.
					</p>
					<Activity class="absolute -bottom-10 -right-10 w-48 h-48 text-white/5" />
				</div>
				<div class="bg-blue-500/5 border border-blue-500/20 rounded-4xl p-10 relative overflow-hidden">
					<h3 class="text-blue-500 font-dot uppercase text-xl mb-4">// Решение Visbody</h3>
					<p class="text-2xl font-sans font-light text-white leading-relaxed">
						Использование Visbody M60/R60 как официального медицинского инструмента с акцентом на
						8-электродный BIA и 3D-осанку.
					</p>
					<ShieldCheck class="absolute -bottom-10 -right-10 w-48 h-48 text-blue-500/10" />
				</div>
			</section>

			<section class="py-12 max-w-6xl mx-auto px-4">
				<h2 class="text-3xl font-dot uppercase text-center mb-16">Для каких направлений</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					{
						[
							{
								title: "Реабилитация",
								desc: "Анализ симметрии плеч, таза, выявление мышечных дисбалансов (ROM).",
							},
							{ title: "Диетология", desc: "Точный расчет жировой и мышечной массы по сегментам." },
							{ title: "Спортивная медицина", desc: "Мониторинг перетренированности и скрытых отеков." },
							{
								title: "Эстетика",
								desc: "Миллиметровый анализ изменения объемов тела до/после процедур.",
							},
						].map((dir, i) => (
							<div class="glass-card p-6 border-t border-white/10 hover:border-blue-500 transition-colors">
								<h4 class="font-dot uppercase text-lg text-white mb-3 text-blue-400">{dir.title}</h4>
								<p class="font-sans text-sm text-gray-400">{dir.desc}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="py-20 mb-20">
				<div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-12">
					<div class="border border-white/10 p-8">
						<FileCheck class="text-blue-500 mb-6" size={40} />
						<h3 class="text-2xl font-dot uppercase mb-4 text-white">Научная база</h3>
						<p class="text-gray-400 font-sans leading-relaxed mb-4">
							Алгоритмы Visbody прошли строгую валидацию и сопоставимы с золотыми медицинскими стандартами
							(DEXA).
						</p>
						<ul class="text-sm text-gray-500 font-sans space-y-2">
							<li>• Одобрение FDA (США)</li>
							<li>• Совпадение с DEXA &gt; 98%</li>
						</ul>
					</div>
					<div class="border border-white/10 p-8">
						<BrainCircuit class="text-brand-accent mb-6" size={40} />
						<h3 class="text-2xl font-dot uppercase mb-4 text-white">IT-Интеграция</h3>
						<p class="text-gray-400 font-sans leading-relaxed">
							Полная поддержка API для интеграции с клиническими системами (МИС), экспорт отчетов в
							формате PDF для электронных карт пациентов. Защищенное облако хранения.
						</p>
					</div>
				</div>
			</section>

			<div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div>
					<h3 class="text-3xl font-dot uppercase mb-6 leading-tight">
						Флагман для клиник:
						<br />
						Visbody M60
					</h3>
					<p class="text-gray-400 font-sans mb-8">
						Интеллектуальный 3D-сканер с 8-электродным биоимпедансным анализом экспертного класса.
					</p>
					<a
						href="/product/visbody-m60"
						class="inline-flex items-center gap-4 border border-blue-500 text-blue-500 px-8 py-4 font-dot uppercase tracking-widest hover:bg-blue-500 hover:text-white transition-all">
						Спецификация M60 <ArrowRight />
					</a>
				</div>
				<div class="glass-card">
					<LeadForm title="Запросить презентацию для клиники" />
				</div>
			</div>
		</div>
	</MainWrapTL>
</Layout>
