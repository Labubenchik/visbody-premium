---
import Layout from "@/layouts/Layout.astro";

import ProductCompare from "@modules/product/ProductCompare.astro";
import ProductFeatures from "@modules/product/ProductFeatures.astro";
import ProductHead from "@modules/product/ProductHead.astro";
import ProductLeadSection from "@modules/product/ProductLeadSection.astro";
import ProductSpecs from "@modules/product/ProductSpecs.astro";
import ProductTechItems from "@modules/product/components/ProductTechItems.astro";
import ProductTechVisual from "@modules/product/components/ProductTechVisual.astro";
import SplitSection from "@/modules/split-section/SplitSection.astro";
import SplitContent from "@/modules/split-section/components/SplitContent.astro";

import m30Image from "@modules/home/hero-section/assets/m-30.webp";
---

<Layout>
	<ProductHead
		primaryAction={{ label: "Узнать цену", href: "#lead-form", id: "priceBtnM60" }}
		secondaryAction={{ label: "Узнать технологии", href: "#tech", withArrow: true }}
		imageSrc={m30Image.src}
		imageAlt="Visbody M30">
		<Fragment slot="eyebrow">3D постуральный анализ</Fragment>
		<Fragment slot="title">
			Visbody M30&nbsp;&mdash; <span class="title-accent">3D-анализатор тела</span> с&nbsp;оценкой осанки
		</Fragment>
		<Fragment slot="description">
			3D-снимок тела, оценка осанки, автоматические измерения и визуализация прогресса в&nbsp;3D-моделях. Для
			фитнеса, реабилитации и&nbsp;wellness-центров.
		</Fragment>
	</ProductHead>

	<ProductFeatures
		features={[
			{
				title: "3D-аватар и обхваты",
				description:
					"Автоматические измерения тела и наглядные 3D-модели до и после помогают отслеживать визуальную динамику клиента.",
			},
			{
				title: "Интеллектуальная оценка осанки",
				description:
					"Оценка 9 параметров осанки: наклон головы, положение плеч, таза и коленей, тип ног (X/O). 3D-детекция скелетных точек.",
			},
			{
				title: "Динамика и отчёты",
				description:
					"Сравнение результатов за&nbsp;разные периоды, визуализация прогресса, отчёты в&nbsp;PDF, мобильный доступ и&nbsp;облачная платформа WellnessHub.",
			},
		]}>
		<Fragment slot="title">Ключевые <span class="title-accent">преимущества</span> Visbody M30</Fragment>
		<Fragment slot="subtitle">
			Технологии, которые делают M30 идеальным выбором для фитнес-клубов, студий персонального тренинга
			и&nbsp;центров реабилитации.
		</Fragment>
	</ProductFeatures>

	<SplitSection>
		<SplitContent slot="left">
			<Fragment slot="title">Технология: <br /><span class="title-accent">3D-анализ осанки</span></Fragment>
			<Fragment slot="text">
				Visbody M30 использует 3D Depth Vision Sensor для снимка тела, оценки осанки и визуального контроля
				прогресса.
			</Fragment>
			<ProductTechItems
				slot="content"
				items={[
					{
						title: "Постуральный анализ",
						description:
							"Автоматическое выявление дисбалансов осанки: наклон головы, положение плеч, таза и коленей. Идеально для реабилитации и коррекции тренировок.",
					},
					{
						title: "Визуальный контроль прогресса",
						description:
							"3D-снимки и автоматические измерения помогают отслеживать изменения фигуры без анализа состава тела.",
					},
				]}
			/>
		</SplitContent>
		<ProductTechVisual
			slot="right"
			title="3D-анализ осанки в реальном времени"
			label="3D скелетная детекция"
			caption="9 параметров осанки + 3D-снимок тела + визуальная динамика"
		/>
	</SplitSection>

	<ProductSpecs
		specs={[
			{ label: "Вход устройства", value: "24 В / 5 А" },
			{ label: "Потребляемая мощность", value: "120 Вт через адаптер" },
			{ label: "Габариты (зеркало)", value: "1860 мм (В) × 550 мм (Ш) × 340 мм (Г)" },
			{ label: "Поворотная платформа", value: "⌀450 мм, высота 92 мм" },
			{ label: "Напольный коврик", value: "1630 × 600 мм" },
			{ label: "Вес нетто (зеркало)", value: "47 кг" },
			{ label: "Вес нетто (платформа)", value: "7 кг" },
			{ label: "Максимальный вес пользователя", value: "180 кг" },
			{ label: "Максимальный рост", value: "200 см" },
			{ label: "Цветовые решения", value: "Белый / Чёрный (M30 Black edition)" },
			{ label: "Основной сенсор", value: "3D Depth Vision Sensor" },
			{ label: "Формат отчётов", value: "Печать A4, мобильная версия H5, веб-панель" },
			{ label: "Хранение данных", value: "Автоматическое облачное хранение, история сканирований" },
		]}>
		<Fragment slot="title">Технические <span class="title-accent">характеристики</span> M30</Fragment>
		<Fragment slot="subtitle">Официальные спецификации Visbody M30 от&nbsp;производителя</Fragment>
	</ProductSpecs>

	<ProductCompare
		columns={{ parameter: "Функция / Характеристика", first: "Visbody M30", second: "Visbody M60" }}
		rows={[
			{
				parameter: "3D сканирование тела",
				first: { value: "3D-аватар" },
				second: { value: "Full HD 3D модель" },
			},
			{
				parameter: "Измерение состава тела (BIA)",
				first: { value: "Нет" },
				second: { value: "BIA + 3D (8 электродов)" },
			},
			{
				parameter: "Количество обхватов тела",
				first: { value: "Автоматические измерения тела", highlight: true },
				second: { value: "14 (полный набор)" },
			},
			{
				parameter: "Оценка осанки (постуральный анализ)",
				first: { value: "9 параметров" },
				second: { value: "До 14 параметров + детальная биомеханика" },
			},
			{
				parameter: "Анализ функции плеча",
				first: { value: "—" },
				second: { value: "Есть" },
			},
			{
				parameter: "Оценка формы ягодиц",
				first: { value: "—" },
				second: { value: "Есть" },
			},
			{
				parameter: "Прогноз формы тела в отчёте",
				first: { value: "—" },
				second: { value: "Есть" },
			},
			{
				parameter: "Экран и управление",
				first: { value: '27" сенсорный / жесты' },
				second: { value: '27" сенсорный + жесты + кнопки' },
			},
			{
				parameter: "Макс. вес пользователя",
				first: { value: "180 кг" },
				second: { value: "180 кг" },
			},
			{
				parameter: "Ценовой сегмент",
				first: { value: "Доступный / средний сегмент", highlight: true },
				second: { value: "Премиум сегмент" },
			},
		]}>
		<Fragment slot="title">
			Сравнение: <br />
			<span class="title-accent">Visbody M30</span> vs <span class="title-accent">Visbody M60</span>
		</Fragment>
		<Fragment slot="subtitle">
			Ключевые технические различия между моделью M30 и флагманской M60.
			<span class="title-accent">Подсвеченные позиции</span> — преимущества M30.
		</Fragment>
	</ProductCompare>

	<ProductFeatures
		features={[
			{
				title: "Фитнес-клубы",
				description:
					"Экспресс-оценка новых членов клуба, повышение конверсии в персональные тренировки через детальный 3D-анализ.",
			},
			{
				title: "Студии персонального тренинга",
				description:
					"Доказательный прогресс для VIP-клиентов. Автоматические замеры обхватов и 3D-аватар без участия тренера.",
			},
			{
				title: "Центры реабилитации",
				description: "Постуральный анализ и отслеживание динамики восстановления после травм и операций.",
			},
		]}>
		<Fragment slot="title">Для кого <span class="title-accent">идеально</span> подходит M30</Fragment>
		<Fragment slot="subtitle">
			Оптимальное решение для бизнеса, где важны точность, визуализация прогресса и оценка осанки
		</Fragment>
	</ProductFeatures>

	<ProductLeadSection>
		<Fragment slot="title">Оставьте заявку для получения коммерческого предложения</Fragment>
		<Fragment slot="text">
			Заполните форму, и наш специалист свяжется с вами для расчёта стоимости и подготовки индивидуального
			предложения.
		</Fragment>
	</ProductLeadSection>
</Layout>
